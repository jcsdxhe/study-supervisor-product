# 复制此文件为 .env，再仅在本机填写。不要把密钥发到聊天、截图或版本库。
MOONSHOT_API_KEY=sk-your-local-key-here

# 官方中国区 OpenAI 兼容端点
MOONSHOT_API_BASE=https://api.moonshot.cn/v1

# 默认模型可选 kimi-k2.6 或 kimi-k3
KIMI_DEFAULT_MODEL=kimi-k2.6

# 课堂模型菜单。Kimi 后续开放新模型时，在服务端追加模型 ID，前端会自动显示。
KIMI_AVAILABLE_MODELS=kimi-k2.6,kimi-k3

# 每次浏览器会话允许的最大请求数（1-20）
KIMI_SESSION_LIMIT=5

# 每节实时语音课堂最多对话轮数（3-50）
KIMI_VOICE_TURN_LIMIT=20

# 仅在明确部署 HTTPS 云代理时改为 true。本机运行保持 false。
ALLOW_CLOUD_PROXY=false

# 云模式必填：访问口令至少 24 字符；签名密钥至少 32 字符。
# 不要把真实值提交到 Git。Render 中使用 Secret / generateValue。
APP_ACCESS_TOKEN=replace-with-a-long-private-access-token
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# 云模式的公开 HTTPS 源站。Render 会自动提供 RENDER_EXTERNAL_URL，可留空。
PUBLIC_ORIGIN=

# 云端登录 Cookie 有效小时数，范围 1-72。
AUTH_SESSION_HOURS=12
